# Mantle-Audit-AI environment variables
# Copy to .env and fill in your values

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Pinata IPFS
PINATA_API_KEY=...
PINATA_SECRET_KEY=...

# Mantle RPC (default: mainnet)
MANTLE_RPC_URL=https://rpc.mantle.xyz
# MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz  # testnet

# Ethereum RPC (for ERC-8004 Identity Registry)
ETH_RPC_URL=https://eth.llamarpc.com

# Private key for on-chain transactions (KEEP SECRET)
PRIVATE_KEY=0x...

# AuditRegistry contract address (after deployment)
AUDIT_REGISTRY_ADDRESS=0x...
